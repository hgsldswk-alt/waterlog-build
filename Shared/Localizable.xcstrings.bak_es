    "用小组件记一杯、切换多套杯量组，查看近 7 天周报。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用小组件记一杯、切换多套杯量组，查看近 7 天周报。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log from your widget, switch between cup sets, and see your 7-day report."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用小工具記一杯、切換多套杯量組，查看近 7 天週報。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィジェットから記録、カップセットの切り替え、7日間のレポートが使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위젯에서 기록하고, 컵 세트를 바꾸고, 7일 리포트를 보세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage per Widget ein, wechsle zwischen Bechersets und sieh deinen 7-Tage-Bericht."
          }
        }
      }
    },
